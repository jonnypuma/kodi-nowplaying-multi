# Kodi Now Playing — multi-server configuration
# Copy to .env and fill in your values:  cp .env.example .env
# Do not put spaces before variable names.

# Optional: stable Flask session key (recommended)
# FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Optional web login. Use username:password; leave empty for no login.
# Strongly recommended if this app is reachable beyond your LAN — without it
# every API endpoint (server CRUD, preferences, artwork) is open.
# BASIC_AUTH=admin:change-this-password

# Optional allowlist of hostnames that user-added Kodi servers may target.
# Comma-separated; unset means any reachable host is allowed.
# KODI_HOST_ALLOWLIST=192.168.0.4,192.168.0.21,kodi.lan

# Optional artwork cache limits
# CACHE_MAX_ART_FILES=500
# CACHE_MAX_ART_MB=1024
# SERVER_AUTH_BACKOFF_SECONDS=900

# Optional container timezone (IANA name, e.g. Europe/Amsterdam). Default: UTC
# TZ=Europe/Amsterdam

# The container runs unprivileged as this uid:gid. It must own the mounted
# ./kodi-np-multi/tmp and ./kodi-np-multi/preferences directories:
#   sudo chown -R 1000:1000 ./kodi-np-multi/tmp ./kodi-np-multi/preferences
# PUID=1000
# PGID=1000

# Optional log level: DEBUG, INFO, WARNING, ERROR (default INFO)
# LOG_LEVEL=INFO

# How many consecutive empty-player polls before /poll_playback returns playing: false
# (client still applies a short debounce after that). Default: 2
POLL_IDLE_CONFIRMATIONS=2

# Optional: JSON-RPC timeouts (seconds). Connect timeout should stay short so
# powered-off boxes fail fast; read timeout covers slow Kodi replies.
# KODI_CONNECT_TIMEOUT=2
# KODI_RPC_TIMEOUT=5
# SERVER_FAIL_BACKOFF_AFTER=3
# Backoff starts at the INITIAL value and doubles up to SERVER_FAIL_BACKOFF_SECONDS,
# so a Kodi box that is still booting is retried in seconds rather than minutes.
# SERVER_FAIL_BACKOFF_INITIAL_SECONDS=15
# SERVER_FAIL_BACKOFF_SECONDS=300

# Server 1 (required for numbered config)
KODI_HOST_1=http://192.168.0.10:8080
KODI_HOST_LABEL_1=Living Room
KODI_USERNAME_1=kodi
KODI_PASSWORD_1=secret

# Server 2 (optional)
# KODI_HOST_2=http://192.168.0.11:8080
# KODI_HOST_LABEL_2=Bedroom
# KODI_USERNAME_2=kodi
# KODI_PASSWORD_2=secret

# Server 3 (optional)
# KODI_HOST_3=http://192.168.0.12:8080
# KODI_HOST_LABEL_3=Basement
# KODI_USERNAME_3=kodi
# KODI_PASSWORD_3=secret

# Server 4 (optional)
# KODI_HOST_4=http://192.168.0.13:8080
# KODI_HOST_LABEL_4=Office
# KODI_USERNAME_4=kodi
# KODI_PASSWORD_4=secret

# Legacy single-server format (used only when no KODI_HOST_N vars are set)
# KODI_HOST=http://192.168.0.10:8080
# KODI_HOST_LABEL=Living Room
# KODI_USER=kodi
# KODI_PASS=secret
