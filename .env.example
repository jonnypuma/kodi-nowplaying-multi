# Kodi Now Playing — multi-server configuration
# Copy to .env and fill in your values:  cp .env.example .env
# Do not put spaces before variable names.

# Optional: stable Flask session key (recommended)
# FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Optional web login. Use username:password; leave empty for no login.
# BASIC_AUTH=admin:change-this-password

# Optional artwork cache limits
# CACHE_MAX_ART_FILES=500
# CACHE_MAX_ART_MB=1024
# SERVER_AUTH_BACKOFF_SECONDS=900

# Optional log level: DEBUG, INFO, WARNING, ERROR (default INFO)
# LOG_LEVEL=INFO

# How many consecutive empty-player polls before /poll_playback returns playing: false
# (client still applies a short debounce after that). Default: 2
POLL_IDLE_CONFIRMATIONS=2

# Server 1 (required for numbered config)
KODI_HOST_1=http://192.168.0.10:8080
KODI_HOST_LABEL_1=Living Room
KODI_USERNAME_1=kodi
KODI_PASSWORD_1=secret

# Server 2 (optional)
# KODI_HOST_2=http://192.168.0.11:8080
# KODI_HOST_LABEL_2=Bedroom
# KODI_USERNAME_2=kodi
# KODI_PASSWORD_2=secret

# Server 3 (optional)
# KODI_HOST_3=http://192.168.0.12:8080
# KODI_HOST_LABEL_3=Basement
# KODI_USERNAME_3=kodi
# KODI_PASSWORD_3=secret

# Server 4 (optional)
# KODI_HOST_4=http://192.168.0.13:8080
# KODI_HOST_LABEL_4=Office
# KODI_USERNAME_4=kodi
# KODI_PASSWORD_4=secret

# Legacy single-server format (used only when no KODI_HOST_N vars are set)
# KODI_HOST=http://192.168.0.10:8080
# KODI_HOST_LABEL=Living Room
# KODI_USER=kodi
# KODI_PASS=secret
