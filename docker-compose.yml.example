services:
  kodi-np-multi:
    build: ./kodi-np-multi
    container_name: kodi-np-multi
    image: kodi-np-multi
    environment:
      - LOG_LEVEL=${LOG_LEVEL:-INFO}
      - ART_TMP_DIR=/app/tmp
      - KODI_HOST_1=${KODI_HOST_1}
      - KODI_HOST_LABEL_1=${KODI_HOST_LABEL_1:-}
      - KODI_USERNAME_1=${KODI_USERNAME_1}
      - KODI_PASSWORD_1=${KODI_PASSWORD_1}
      # Server 2 (optional)
      - KODI_HOST_2=${KODI_HOST_2}
      - KODI_HOST_LABEL_2=${KODI_HOST_LABEL_2:-}
      - KODI_USERNAME_2=${KODI_USERNAME_2}
      - KODI_PASSWORD_2=${KODI_PASSWORD_2}
      # Server 3 (optional)
      - KODI_HOST_3=${KODI_HOST_3}
      - KODI_HOST_LABEL_3=${KODI_HOST_LABEL_3:-}
      - KODI_USERNAME_3=${KODI_USERNAME_3}
      - KODI_PASSWORD_3=${KODI_PASSWORD_3}
      - KODI_HOST_4=${KODI_HOST_4}
      - KODI_HOST_LABEL_4=${KODI_HOST_LABEL_4:-}
      - KODI_USERNAME_4=${KODI_USERNAME_4}
      - KODI_PASSWORD_4=${KODI_PASSWORD_4}
      - POLL_IDLE_CONFIRMATIONS=2
      # Optional web login: username:password. Leave empty to disable.
      - BASIC_AUTH=${BASIC_AUTH:-}
      - CACHE_MAX_ART_FILES=${CACHE_MAX_ART_FILES:-500}
      - CACHE_MAX_ART_MB=${CACHE_MAX_ART_MB:-1024}
    env_file:
      - ./.env
    ports:
      - 6001:6001
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    volumes:
      - ./kodi-np-multi/tmp:/app/tmp
      - ./kodi-np-multi/preferences:/app/preferences
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:6001/health', timeout=4)"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
